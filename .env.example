# =============================================================================
# ExamPulse AI - Environment Variables
# =============================================================================
# Copy this file to `.env` for local development:
#     cp .env.example .env
#
# NONE of the AI_* keys below are required. ExamPulse AI's core analytics,
# predictions, study plans, and Mentor recommendations all run on
# deterministic rules + local NLP/ML and work correctly with these left
# blank. They only unlock optional natural-language wording enhancements.
# =============================================================================

# --- Flask core --------------------------------------------------------------
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# --- Database ------------------------------------------------------------------
# Local development (SQLite) — leave unset to use the bundled SQLite file at
# data/exampulse.db automatically.
# DATABASE_URL=sqlite:///data/exampulse.db
#
# Production (Neon PostgreSQL) — get this from your Neon project dashboard.
# DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/exampulse?sslmode=require

# --- File uploads --------------------------------------------------------------
UPLOAD_FOLDER=data/uploads
MAX_UPLOAD_MB=20

# --- Optional free-tier generative AI (Level 3 enhancement layer only) ------
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=

# --- Misc ------------------------------------------------------------------------
SQL_ECHO=false
PORT=5000
